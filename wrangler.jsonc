{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devboard",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
